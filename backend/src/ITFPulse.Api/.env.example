ASPNETCORE_ENVIRONMENT=Development
ITFPULSE_CORS__ALLOWEDORIGINS__0=http://localhost:6510
ITFPULSE_SERVICE__NAME=ITF Pulse API
ITFPULSE_ConnectionStrings__ITFPulse=CONNSTRING
# Set true on Render, which terminates HTTPS before forwarding to the container.
ITFPULSE_Hosting__HttpsTerminatedAtProxy=false
